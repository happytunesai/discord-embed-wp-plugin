# Exclude non-plugin files from `git archive` exports
/.gitignore export-ignore
/.gitattributes export-ignore
/README.md export-ignore
/.vscode/ export-ignore
/.idea/ export-ignore

# Dev/maintenance helpers not needed in distribution
/admin-database-debug.php export-ignore
/admin-update.php export-ignore
/setup-database.php export-ignore
/update-database.php export-ignore
/validate-plugin.php export-ignore

# Root-level translation helper files (plugin uses /languages/*.mo)
/js_strings*.po export-ignore
/js_strings*_clean.txt export-ignore

# Do not ship the dist/build outputs if any
/dist/ export-ignore
/build/ export-ignore
